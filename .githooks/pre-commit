#!/bin/sh
# Refuse a commit that would add a secret. Enabled per clone with:
#   git config core.hooksPath .githooks
# Needs gitleaks (brew install gitleaks); skipped with a warning without it.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed; secret check skipped" >&2
    exit 0
fi
exec gitleaks git --pre-commit --staged --redact --config .gitleaks.toml --no-banner .
