// resources.rc.in -- the executable's icon and its version block.
//
// Configured by CMake, which substitutes the paths. Backslashes are doubled
// because RC treats them as escapes.
//
// DELIBERATELY ASCII, every character of it. rc.exe reads a resource script in
// the machine's ANSI code page unless told otherwise, and this file is UTF-8, so
// an em dash in the sources arrives in the Properties dialog as "a?"" -- which
// is what the FileDescription below said until somebody read it. The fix could
// be /c65001, but that is an MSVC switch and this project is also cross-compiled
// with windres; keeping the file to ASCII needs no switch on either.

// -- The icon ---------------------------------------------------------------
//
// Numbered 1 deliberately. Explorer, the taskbar and the shortcut all show the
// LOWEST-numbered icon resource in the executable, so the application icon has
// to be the first one rather than merely present -- and it has to be in the
// binary at all, which is what makes a shortcut show SolStream's mark instead of
// the generic window Windows falls back to.
//
// The .ico carries 16, 20, 24, 32, 48 and 256 as separate artboards. The three
// smallest are drawn on the pixel grid rather than scaled: see
// assets/logo/make-logo.swift, which is the only place the mark is described.
1 ICON "@SOLSTREAM_ICON_RC@"

// -- Third-party notices ----------------------------------------------------
//
// libopus's licence, which asks to go wherever a binary built from it goes --
// and what ships is this one file. `SolStream.exe --licenses` prints it.
OPUS_COPYING RCDATA "@SOLSTREAM_OPUS_COPYING_RC@"

// -- Version information ----------------------------------------------------
//
// Without this the file's Properties dialog is blank, the UAC prompt has no
// program name to show, and every antivirus heuristic that weighs "unsigned AND
// anonymous" counts both. It is the cheapest half of looking like a real
// program; the other half is a signature, which costs money.
1 VERSIONINFO
FILEVERSION     @SOLSTREAM_VERSION_COMMA@
PRODUCTVERSION  @SOLSTREAM_VERSION_COMMA@
FILEOS          0x00000004L   // VOS__WINDOWS32
FILETYPE        0x00000001L   // VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = US English, 04B0 = Unicode. The pair has to match the
        // Translation value below or the shell reads neither.
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "SolStream"
            VALUE "FileDescription",  "SolStream - stream one Windows application to your Mac"
            VALUE "FileVersion",      "@SOLSTREAM_VERSION@"
            VALUE "InternalName",     "SolStream"
            VALUE "OriginalFilename", "SolStream.exe"
            VALUE "ProductName",      "SolStream"
            VALUE "ProductVersion",   "@SOLSTREAM_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
